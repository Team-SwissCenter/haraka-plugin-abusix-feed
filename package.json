{
  "name": "haraka-plugin-abusix-feed",
  "version": "1.1.0",
  "description": "Haraka plugin to feed transaction data to Abusix",
  "main": "index.js",
  "scripts": {
    "lint": "npx eslint *.js test/*.js",
    "lint:fix": "npx eslint *.js test --fix",
    "prettier": "npx prettier . --check",
    "prettier:fix": "npx prettier . --write --log-level=warn",
    "test": "node --test test/*.js",
    "versions": "npx npm-dep-mgr check",
    "versions:fix": "npx npm-dep-mgr update"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sriccio/haraka-plugin-abusix-feed.git"
  },
  "keywords": [
    "haraka",
    "plugin",
    "abusix-feed"
  ],
  "author": "S\u00e9bastien Riccio <sriccio@swisscenter.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sriccio/haraka-plugin-abusix-feed/issues"
  },
  "homepage": "https://github.com/sriccio/haraka-plugin-abusix-feed#readme",
  "devDependencies": {
    "@haraka/email-address": "^3.1.6",
    "@haraka/eslint-config": "^3.0.0",
    "address-rfc2821": "^2.2.1",
    "haraka-test-fixtures": "^1.7.2"
  },
  "prettier": {
    "singleQuote": true,
    "semi": false
  }
}
